# systemd unit for the Flight Tracker server (polls the cloud ADS-B API, runs
# the WebSocket hub, and serves the built web app). Installed to
# /etc/systemd/system/ by install-on-pi.sh.
[Unit]
Description=Flight Tracker server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APPDIR__
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
ExecStart=__PNPM__ -F server start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
